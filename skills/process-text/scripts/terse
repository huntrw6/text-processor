#!/usr/bin/env python3
"""terse - shrink a Markdown file's prose to fewer tokens, keeping every fact.

    terse text.md                 update text.md (the original is kept as text.md.bak)
    terse text.md new-text.md     write new-text.md and leave text.md unchanged
    terse text.md --dry-run       show what would change
    terse text.md --level ultra   lite | full (default) | ultra

    terse --install               put this command in ~/.local/bin so you can run it anywhere

Other options: --include-warnings, --no-backup, --force, -v.
Run 'terse --help' for the full list. This file needs terse.py and ste.py next to it.
"""
import os
import shutil
import sys
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(HERE))

REQUIRED = ('terse.py', 'ste.py')


def check_files() -> bool:
    """All the files must sit in the same folder. Say which one is missing, instead of a Python traceback."""
    missing = [f for f in REQUIRED if not (HERE / f).is_file()]
    if not missing:
        return True
    print(f"terse: missing file(s) in {HERE}: {', '.join(missing)}", file=sys.stderr)
    print(f"  terse needs all of these in one folder: terse, {', '.join(REQUIRED)}", file=sys.stderr)
    near = sorted(p.name for p in HERE.glob("*.py"))
    print(f"  Found there now: {', '.join(near) if near else 'no .py files'}", file=sys.stderr)
    print("  If a download was renamed (for example 'ste (1).py'), rename it to the exact name above.", file=sys.stderr)
    return False


def install(name: str) -> int:
    if not check_files():
        return 1
    dest = Path.home() / ".local" / "bin"
    dest.mkdir(parents=True, exist_ok=True)
    target = Path(os.path.realpath(__file__))
    for f in (target, HERE / "terse.py", HERE / "ste.py"):
        os.chmod(f, os.stat(f).st_mode | 0o111)
    link = dest / name
    if link.is_symlink() or link.exists():
        link.unlink()
    try:
        link.symlink_to(target)
    except OSError as e:
        print(f"Could not create {link}: {e}\nRun it as: python {target} text.md", file=sys.stderr)
        return 1
    print(f"Installed: {link} -> {target}")
    if shutil.which(name) is None:
        print(f"\n{dest} is not on your PATH yet. Add {dest} to PATH in your shell settings, then open a new terminal.")
    print(f"\nTry: {name} --help")
    return 0


if __name__ == "__main__":
    if sys.argv[1:2] == ["--install"]:
        sys.exit(install(sys.argv[2] if len(sys.argv) > 2 else "terse"))
    if len(sys.argv) == 1:
        print(__doc__)
        sys.exit(2)
    if not check_files():
        sys.exit(1)
    import terse
    sys.exit(terse.main(sys.argv[1:]))
